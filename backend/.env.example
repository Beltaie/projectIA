APP_DB_NAME=smartcampus
SESSION_MEMORY_TTL_SECONDS=3600
SESSION_MEMORY_MAX_SESSIONS=1000
SESSION_MEMORY_MAX_MESSAGES=20
SESSION_MEMORY_CLEANUP_INTERVAL_SECONDS=60
