APP_NAME=SmartCampus AI API
APP_DESCRIPTION=Backend API for SmartCampus AI
APP_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql+psycopg://smartcampus_app:change-me@localhost:5432/smartcampus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-postgres-admin-password
