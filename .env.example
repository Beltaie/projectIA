# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Backend (FastAPI)
APP_NAME=SmartCampus AI API
APP_DESCRIPTION=Backend API for SmartCampus AI
APP_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (local development only; change these before any shared deployment)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_dev_password
DATABASE_URL=postgresql://smartcampus:smartcampus_dev_password@localhost:5432/smartcampus

# pgAdmin (local development only)
PGADMIN_DEFAULT_EMAIL=admin@smartcampus.local
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_password

# LLM - defaults to a local Ollama-compatible endpoint
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_MODEL_PATH=./ai-agent/models/llm
LLM_API_KEY=

# Whisper speech-to-text
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=fr
WHISPER_CACHE_DIR=./ai-agent/models/whisper
